rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function hasField(data, field) {
      return data.keys().hasAny([field]);
    }

    function hasCompanyId(data) {
      return hasField(data, 'companyId') && isNonEmptyString(data.companyId);
    }

    function hasOwnerUidField(data) {
      return hasField(data, 'ownerUid');
    }

    function isOwnedByCurrentUser(data) {
      return hasOwnerUidField(data)
        && data.ownerUid is string
        && data.ownerUid == currentUid();
    }

    function ownerUidIsSelfOrMissing(data) {
      return !hasField(data, 'ownerUid') || data.ownerUid == currentUid();
    }

    function membershipId(companyId) {
      return companyId + '_' + currentUid();
    }

    function membershipPath(companyId) {
      return /databases/$(database)/documents/companyMembers/$(membershipId(companyId));
    }

    function membershipExists(companyId) {
      return signedIn() && isNonEmptyString(companyId) && exists(membershipPath(companyId));
    }

    function membershipData(companyId) {
      return get(membershipPath(companyId)).data;
    }

    function companyExists(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId));
    }

    function isCompanyOwner(companyId) {
      return signedIn()
        && companyExists(companyId)
        && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == currentUid();
    }

    function isActiveMember(companyId) {
      return membershipExists(companyId)
        && membershipData(companyId).get('companyId', null) == companyId
        && membershipData(companyId).get('userUid', null) == currentUid()
        && membershipData(companyId).get('status', null) == 'active';
    }

    function hasActiveMembership(companyId) {
      return isActiveMember(companyId);
    }

    function memberRole(companyId) {
      return membershipExists(companyId) ? membershipData(companyId).get('role', null) : null;
    }

    function hasCompanyRole(companyId, allowedRoles) {
      return isActiveMember(companyId) && memberRole(companyId) in allowedRoles;
    }

    function hasAnyCompanyRole(companyId, roles) {
      return hasCompanyRole(companyId, roles);
    }

    function canReadCompany(companyId) {
      return isNonEmptyString(companyId)
        && (isCompanyOwner(companyId) || isActiveMember(companyId));
    }

    function canWriteCompany(companyId) {
      return isNonEmptyString(companyId)
        && (isCompanyOwner(companyId)
          || hasCompanyRole(companyId, ['owner', 'director', 'admin', 'editor']));
    }

    function canManageCompany(companyId) {
      return isNonEmptyString(companyId)
        && (isCompanyOwner(companyId)
          || hasCompanyRole(companyId, ['owner', 'director', 'admin']));
    }

    function canAccessSensitiveWorkforceData(companyId) {
      return canManageCompany(companyId);
    }

    function canReadSensitiveWorkforceRecord() {
      return signedIn()
        && hasCompanyId(resource.data)
        && canAccessSensitiveWorkforceData(resource.data.companyId);
    }

    function validSensitiveWorkforceCreate(coreValid) {
      return signedIn()
        && auditCreateFieldsAreSafe(request.resource.data)
        && validDomainEnvelope(request.resource.data)
        && ownerUidIsSelfOrMissing(request.resource.data)
        && canAccessSensitiveWorkforceData(request.resource.data.companyId)
        && hasServerCreateTimestamps(request.resource.data)
        && request.resource.data.createdBy == currentUid()
        && request.resource.data.updatedBy == currentUid()
        && coreValid;
    }

    function validSensitiveWorkforceUpdate(coreValid) {
      return signedIn()
        && auditUpdateFieldsAreSafe()
        && companyIdUnchanged()
        && ownerUidUnchanged()
        && canAccessSensitiveWorkforceData(resource.data.companyId)
        && validDomainEnvelope(request.resource.data)
        && domainImmutableFieldsUnchanged()
        && hasServerUpdateTimestamp(request.resource.data)
        && request.resource.data.updatedBy == currentUid()
        && coreValid;
    }

    function canCreateCompanyDocument(companyId) {
      return isNonEmptyString(companyId) && canWriteCompany(companyId);
    }

    function belongsToCompany(data) {
      return hasCompanyId(data) && canReadCompany(data.companyId);
    }

    // La membresía inicial del propietario se crea exclusivamente mediante
    // canCreateInitialOwnerMembership. Las asignaciones normales siguen esta jerarquía.
    function assignableRoles(companyId) {
      return isCompanyOwner(companyId)
        ? ['director', 'admin', 'editor', 'viewer', 'invitado']
        : hasCompanyRole(companyId, ['director'])
          ? ['admin', 'editor', 'viewer', 'invitado']
          : hasCompanyRole(companyId, ['admin'])
            ? ['editor', 'viewer', 'invitado']
            : [];
    }

    function canCreateInitialOwnerMembership(memberId) {
      let companyId = request.resource.data.companyId;
      return signedIn()
        && hasCompanyId(request.resource.data)
        && memberId == membershipId(companyId)
        && request.resource.data.get('userUid', null) == currentUid()
        && request.resource.data.get('status', null) == 'active'
        && request.resource.data.get('role', null) in ['owner', 'director']
        && existsAfter(/databases/$(database)/documents/companies/$(companyId))
        && getAfter(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == currentUid();
    }


    function auditCreateFieldsAreSafe(data) {
      return (!hasField(data, 'createdAt') || data.createdAt is string || data.createdAt == request.time)
        && (!hasField(data, 'updatedAt') || data.updatedAt is string || data.updatedAt == request.time)
        && (!hasField(data, 'createdBy') || data.createdBy == currentUid())
        && (!hasField(data, 'updatedBy') || data.updatedBy == currentUid());
    }

    function auditUpdateFieldsAreSafe() {
      return (!hasField(resource.data, 'createdAt') || request.resource.data.createdAt == resource.data.createdAt)
        && (!hasField(resource.data, 'createdBy') || request.resource.data.createdBy == resource.data.createdBy)
        && (!hasField(request.resource.data, 'updatedAt') || request.resource.data.updatedAt is string || request.resource.data.updatedAt == request.time)
        && (!hasField(request.resource.data, 'updatedBy') || request.resource.data.updatedBy == currentUid());
    }

    function hasNoRoleFields(data) {
      return !hasField(data, 'role') && !hasField(data, 'companyRole');
    }

    function roleFieldsUnchanged() {
      return (!hasField(resource.data, 'role') || request.resource.data.role == resource.data.role)
        && (hasField(resource.data, 'role') || !hasField(request.resource.data, 'role'))
        && (!hasField(resource.data, 'companyRole') || request.resource.data.companyRole == resource.data.companyRole)
        && (hasField(resource.data, 'companyRole') || !hasField(request.resource.data, 'companyRole'));
    }

    function validCompanyCreate() {
      return signedIn()
        && auditCreateFieldsAreSafe(request.resource.data)
        && request.resource.data.ownerUid == currentUid()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 180;
    }

    function canCreateCompanyRecord() {
      return signedIn()
        && auditCreateFieldsAreSafe(request.resource.data)
        && hasCompanyId(request.resource.data)
        && canWriteCompany(request.resource.data.companyId)
        && ownerUidIsSelfOrMissing(request.resource.data);
    }

    function canReadCompanyRecord() {
      return signedIn()
        && hasCompanyId(resource.data)
        && canReadCompany(resource.data.companyId);
    }

    function companyIdUnchanged() {
      return hasCompanyId(resource.data)
        && hasCompanyId(request.resource.data)
        && request.resource.data.companyId == resource.data.companyId;
    }

    function ownerUidUnchanged() {
      return (hasOwnerUidField(resource.data)
          && hasOwnerUidField(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid)
        || (!hasOwnerUidField(resource.data)
          && !hasOwnerUidField(request.resource.data));
    }

    function personalScopeUnchanged() {
      return !hasCompanyId(resource.data) && !hasCompanyId(request.resource.data);
    }

    function canUpdateCompanyRecord() {
      return signedIn()
        && auditUpdateFieldsAreSafe()
        && companyIdUnchanged()
        && canWriteCompany(resource.data.companyId)
        && ownerUidUnchanged();
    }

    function companyScopeValid(data) {
      return !hasCompanyId(data) || canWriteCompany(data.companyId);
    }

    // Si el documento declara companyId, solo la autorización empresarial abre acceso.
    // Sin companyId (documento estrictamente personal), solo el ownership personal abre acceso.
    function canCreateOwnedOrCompanyRecord() {
      return signedIn()
        && auditCreateFieldsAreSafe(request.resource.data)
        && companyScopeValid(request.resource.data)
        && (
          (hasCompanyId(request.resource.data)
            && canWriteCompany(request.resource.data.companyId)
            && ownerUidIsSelfOrMissing(request.resource.data))
          || (!hasCompanyId(request.resource.data) && isOwnedByCurrentUser(request.resource.data))
        );
    }

    function canReadOwnedOrCompanyRecord() {
      return signedIn()
        && (
          (hasCompanyId(resource.data) && canReadCompany(resource.data.companyId))
          || (!hasCompanyId(resource.data) && isOwnedByCurrentUser(resource.data))
        );
    }

    function canUpdateOwnedOrCompanyRecord() {
      return signedIn()
        && auditUpdateFieldsAreSafe()
        && ownerUidUnchanged()
        && companyScopeValid(request.resource.data)
        && (
          (hasCompanyId(resource.data)
            && companyIdUnchanged()
            && canWriteCompany(resource.data.companyId))
          || (personalScopeUnchanged() && isOwnedByCurrentUser(resource.data))
        );
    }



    function hasNoPublicDocumentUrls(data) {
      return !hasField(data, 'fileUrl')
        && !hasField(data, 'file_url')
        && !hasField(data, 'downloadUrl')
        && !hasField(data, 'downloadURL')
        && !hasField(data, 'publicUrl');
    }

    function validDocumentEnvelope(data) {
      return data.fileSize is number
        && data.fileSize <= 15 * 1024 * 1024
        && data.contentType is string
        && data.title is string
        && data.title.size() > 0
        && data.get('status', null) in ['active', 'uploading', 'quarantined', 'pending', 'uploaded', 'processing', 'analyzed', 'error', 'archived', 'ai_disabled']
        && hasNoPublicDocumentUrls(data);
    }

    function validDocumentCreate() {
      return canCreateCompanyRecord()
        && validDocumentEnvelope(request.resource.data)
        && request.resource.data.get('status', null) == 'uploading'
        && request.resource.data.keys().hasOnly(['companyId','ownerUid','title','contentType','fileSize','fileType','status','correlationId','release','docType','createdAt','updatedAt','createdBy','updatedBy']);
    }

    function validDocumentUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return canUpdateCompanyRecord()
        && validDocumentEnvelope(request.resource.data)
        && (
          (
            (
              (resource.data.status == 'uploading' && request.resource.data.status in ['quarantined','error'])
              || (resource.data.status == 'quarantined' && request.resource.data.status == 'error')
            )
            && changed.hasOnly(['status','correlationId','errorMessage','updatedAt','updatedBy'])
          )
          || (
            resource.data.status in ['active','pending','uploaded']
            && request.resource.data.status == 'processing'
            && changed.hasOnly(['status','aiDisabled','errorMessage','correlationId','release','updatedAt','updatedBy'])
          )
          || (
            resource.data.status == 'processing'
            && request.resource.data.status in ['analyzed','ai_disabled','error']
            && changed.hasOnly([
              'status','aiDisabled','errorMessage','correlationId','release','docType',
              'rfc_emisor','rfc_receptor','subtotal','iva','total','currency','docDate',
              'concepts','ai_summary','ai_classification','tags','updatedAt','updatedBy'
            ])
          )
          || (
            resource.data.status != 'archived'
            && request.resource.data.status == 'archived'
            && changed.hasOnly(['status','archivedAt','updatedAt','updatedBy'])
          )
        );
    }

    function canCreateAiBudget() {
      return hasCompanyId(request.resource.data)
        && canManageCompany(request.resource.data.companyId);
    }

    function canUpdateAiBudget() {
      return hasCompanyId(resource.data)
        && hasCompanyId(request.resource.data)
        && request.resource.data.companyId == resource.data.companyId
        && canManageCompany(resource.data.companyId);
    }

    function canReadAiFinancialData(data) {
      return signedIn()
        && hasCompanyId(data)
        && canManageCompany(data.companyId);
    }

    function validText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function validMoney(value) { return value is number && value >= 0 && value <= 1000000000; }
    function validPercent(value) { return value is number && value >= 0 && value <= 100; }
    function validDate(value) { return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?$'); }
    function optionalDate(data, field) { return !hasField(data, field) || validDate(data[field]); }
    function optionalText(data, field, max) { return !hasField(data, field) || (data[field] is string && data[field].size() <= max); }
    function optionalEmail(data, field) { return !hasField(data, field) || (data[field] is string && data[field].size() <= 254 && data[field].matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')); }
    function optionalNumber(data, field, min, max) { return !hasField(data, field) || (data[field] is number && data[field] >= min && data[field] <= max); }
    function optionalList(data, field, max) { return !hasField(data, field) || (data[field] is list && data[field].size() <= max); }
    function requiredNumber(data, field, min, max) { return hasField(data, field) && data[field] is number && data[field] >= min && data[field] <= max; }
    function onlyFields(data, domainFields) { return data.keys().hasOnly(domainFields.concat(['companyId', 'ownerUid', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'archivedAt'])); }
    function hasServerCreateTimestamps(data) { return data.createdAt == request.time && data.updatedAt == request.time; }
    function hasServerUpdateTimestamp(data) { return data.updatedAt == request.time; }
    function validDomainEnvelope(data) { return validText(data.companyId,180) && (!hasField(data,'ownerUid') || (data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 180)); }
    function domainImmutableFieldsUnchanged() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['companyId','ownerUid','createdAt','createdBy']); }
    function validDomainCreate(coreValid) { return canCreateCompanyRecord() && validDomainEnvelope(request.resource.data) && hasServerCreateTimestamps(request.resource.data) && request.resource.data.createdBy == currentUid() && request.resource.data.updatedBy == currentUid() && coreValid; }
    function validDomainUpdate(coreValid) { return canUpdateCompanyRecord() && validDomainEnvelope(request.resource.data) && domainImmutableFieldsUnchanged() && hasServerUpdateTimestamp(request.resource.data) && request.resource.data.updatedBy == currentUid() && coreValid; }

    function validCrmClient(data) { return onlyFields(data, ['name','email','phone','rfc','segment','status','industry','address','assignedTo','total_revenue','notes']) && validText(data.name, 180) && optionalEmail(data,'email') && optionalText(data,'phone',40) && optionalText(data,'rfc',20) && optionalText(data,'segment',50) && optionalText(data,'industry',100) && optionalText(data,'address',500) && optionalText(data,'assignedTo',5000) && optionalText(data,'notes',5000) && data.status in ['prospecto', 'activo', 'inactivo', 'archived'] && optionalNumber(data,'total_revenue',0,1000000000); }
    function validCrmDeal(data) { return onlyFields(data, ['clientId','client_name','title','stage','amount','probability','expectedClose','assignedTo','description','notes']) && optionalText(data,'clientId',5000) && optionalText(data,'client_name',5000) && validText(data.title,180) && optionalDate(data,'expectedClose') && optionalText(data,'assignedTo',5000) && optionalText(data,'description',5000) && optionalText(data,'notes',5000) && data.stage in ['prospecto','contactado','calificado','propuesta','negociacion','ganado','perdido','cerrado_ganado','cerrado_perdido','archived'] && requiredNumber(data,'probability',0,100) && optionalNumber(data,'amount',0,1000000000); }
    function validCrmInteraction(data) { return onlyFields(data, ['clientId','clientName','type','date','summary','subject','notes','outcome','nextAction','nextActionDate']) && validText(data.clientId,180) && optionalText(data,'clientName',5000) && data.type in ['llamada','email','reunion','mensaje','nota'] && validDate(data.date) && optionalText(data,'summary',5000) && optionalText(data,'subject',5000) && optionalText(data,'notes',5000) && optionalText(data,'outcome',5000) && optionalText(data,'nextAction',5000) && optionalDate(data,'nextActionDate') && (validText(data.get('summary',''),5000) || validText(data.get('subject',''),5000)); }
    function validEmployee(data) { return onlyFields(data, ['fullName','email','phone','department','position','employmentType','status','hireDate','baseSalary','rfc','curp','imssNumber','bankAccount','bank','emergency_contact','notes']) && validText(data.fullName,180) && optionalEmail(data,'email') && optionalText(data,'phone',40) && optionalText(data,'department',100) && optionalText(data,'position',100) && optionalDate(data,'hireDate') && optionalText(data,'rfc',20) && optionalText(data,'curp',30) && optionalText(data,'imssNumber',30) && optionalText(data,'bankAccount',50) && optionalText(data,'bank',100) && optionalText(data,'emergency_contact',300) && optionalText(data,'notes',5000) && data.employmentType in ['tiempo_completo','medio_tiempo','contrato','practicante'] && data.status in ['activo','inactivo','vacaciones','baja','archived'] && optionalNumber(data,'baseSalary',0,1000000000); }
    function validPayroll(data) { return onlyFields(data, ['employeeId','employeeName','period','period_type','baseSalary','bonuses','overtime','deductions_imss','deductions_isr','other_deductions','netPay','status','paymentDate','notes']) && validText(data.employeeId,180) && optionalText(data,'employeeName',5000) && validDate(data.period) && data.period_type in ['semanal','quincenal','mensual'] && requiredNumber(data,'baseSalary',0,1000000000) && requiredNumber(data,'bonuses',0,1000000000) && requiredNumber(data,'overtime',0,1000000000) && requiredNumber(data,'deductions_imss',0,1000000000) && requiredNumber(data,'deductions_isr',0,1000000000) && requiredNumber(data,'other_deductions',0,1000000000) && requiredNumber(data,'netPay',0,1000000000) && data.status in ['pendiente','procesando','pagado','cancelado','archived'] && optionalDate(data,'paymentDate') && optionalText(data,'notes',5000); }
    function validReview(data) { return onlyFields(data, ['employeeId','employeeName','reviewer','period','reviewDate','score_productivity','score_quality','score_teamwork','score_punctuality','score_leadership','strengths','areas_improvement','goals_next_period','overallRating','salary_adjustment','notes']) && validText(data.employeeId,180) && optionalText(data,'employeeName',5000) && optionalText(data,'reviewer',5000) && validText(data.period,180) && validDate(data.reviewDate) && requiredNumber(data,'score_productivity',0,10) && requiredNumber(data,'score_quality',0,10) && requiredNumber(data,'score_teamwork',0,10) && requiredNumber(data,'score_punctuality',0,10) && requiredNumber(data,'score_leadership',0,10) && optionalText(data,'strengths',5000) && optionalText(data,'areas_improvement',5000) && optionalText(data,'goals_next_period',5000) && data.overallRating in ['excepcional','bueno','satisfactorio','necesita_mejora','insatisfactorio'] && requiredNumber(data,'salary_adjustment',-100,100) && optionalText(data,'notes',5000); }
    function validKpi(data) { return onlyFields(data, ['name','category','target','current','unit','frequency','status','owner','notes']) && validText(data.name,180) && optionalText(data,'category',100) && requiredNumber(data,'target',-1000000000,1000000000) && requiredNumber(data,'current',-1000000000,1000000000) && optionalText(data,'unit',30) && data.frequency in ['semanal','mensual','trimestral','anual'] && data.status in ['alcanzado','en_curso','en_riesgo','critico','archived'] && optionalText(data,'owner',5000) && optionalText(data,'notes',5000); }
    function validProject(data) { return onlyFields(data, ['name','description','status','priority','owner','startDate','endDate','budget','spent','progress','team','tags']) && validText(data.name,180) && optionalText(data,'description',5000) && data.status in ['planificado','en_curso','pausado','completado','cancelado','archived'] && data.priority in ['baja','media','alta','critica'] && optionalText(data,'owner',5000) && optionalDate(data,'startDate') && optionalDate(data,'endDate') && optionalNumber(data,'budget',0,1000000000) && optionalNumber(data,'spent',0,1000000000) && requiredNumber(data,'progress',0,100) && optionalList(data,'team',100) && optionalList(data,'tags',100); }
    function validTask(data) { return onlyFields(data, ['projectId','title','description','status','priority','assignee','dueDate','estimatedHours']) && validText(data.projectId,180) && validText(data.title,180) && optionalText(data,'description',5000) && data.status in ['pendiente','en_curso','bloqueado','completado','archived'] && data.priority in ['baja','media','alta','critica'] && optionalText(data,'assignee',5000) && optionalDate(data,'dueDate') && optionalNumber(data,'estimatedHours',0,100000); }
    function validTicket(data) { return onlyFields(data, ['subject','description','category','status','priority','resolved_date']) && validText(data.subject,180) && validText(data.description,5000) && optionalText(data,'category',100) && data.status in ['abierto','en_proceso','resuelto','cerrado','archived'] && data.priority in ['baja','media','alta','urgente'] && optionalDate(data,'resolved_date'); }

    match /users/{userId} {
      allow read: if signedIn() && userId == currentUid();
      allow create: if signedIn()
        && userId == currentUid()
        && auditCreateFieldsAreSafe(request.resource.data)
        && hasNoRoleFields(request.resource.data);
      allow update: if signedIn()
        && userId == currentUid()
        && auditUpdateFieldsAreSafe()
        && roleFieldsUnchanged();
      allow delete: if false;
    }

    // Only the trusted Next publisher can create or modify confirmed evidence.
    match /companies/{companyId}/regulatoryNotices/{noticeId} {
      allow read: if signedIn() && canReadCompany(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/regulatorySync/{streamId} {
      allow read, write: if false;
    }

    match /companies/{companyId} {
      allow create: if validCompanyCreate();
      allow read: if canReadCompany(companyId);
      allow update: if canManageCompany(companyId)
        && auditUpdateFieldsAreSafe()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    match /companyMembers/{memberId} {
      allow create: if signedIn()
        && auditCreateFieldsAreSafe(request.resource.data)
        && hasCompanyId(request.resource.data)
        && request.resource.data.get('status', null) in ['active', 'pending', 'archived']
        && (
          canCreateInitialOwnerMembership(memberId)
          || (
            canManageCompany(request.resource.data.companyId)
            && request.resource.data.get('role', null) in assignableRoles(request.resource.data.companyId)
          )
        );

      allow read: if signedIn()
        && (
          resource.data.userUid == currentUid()
          || canManageCompany(resource.data.companyId)
        );

      allow update: if signedIn()
        && auditUpdateFieldsAreSafe()
        && hasCompanyId(resource.data)
        && hasCompanyId(request.resource.data)
        && request.resource.data.companyId == resource.data.companyId
        && canManageCompany(resource.data.companyId)
        && request.resource.data.get('role', null) in assignableRoles(resource.data.companyId)
        && request.resource.data.get('status', null) in ['active', 'pending', 'archived'];

      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if hasCompanyId(resource.data) && canManageCompany(resource.data.companyId);
      allow write: if false;
    }

    match /aiUsage/{id} {
      allow read: if canReadAiFinancialData(resource.data);
      allow create, update, delete: if false;
    }

    match /aiCostLogs/{id} {
      allow read: if canReadAiFinancialData(resource.data);
      allow create, update, delete: if false;
    }

    match /aiAuditLogs/{id} {
      allow read: if canReadAiFinancialData(resource.data);
      allow create, update, delete: if false;
    }

    match /aiBudgets/{id} {
      allow read: if canReadAiFinancialData(resource.data);
      allow create: if canCreateAiBudget();
      allow update: if canUpdateAiBudget();
      allow delete: if false;
    }

    match /observabilityEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['eventName','severity','source','correlationId','ownerUid','companyId','route','errorName','errorMessage','appVersion','buildId','gitSha','deployEnv','retentionDays','createdAt'])
        && request.resource.data.eventName in ['frontend_error','ai_request_failed','function_request_failed','document_upload_failed','document_analyze_failed']
        && request.resource.data.severity in ['ERROR','CRITICAL']
        && request.resource.data.source == 'frontend'
        && request.resource.data.ownerUid == currentUid()
        && request.resource.data.createdAt == request.time
        && validText(request.resource.data.correlationId,160)
        && optionalText(request.resource.data,'route',300)
        && optionalText(request.resource.data,'errorName',100)
        && optionalText(request.resource.data,'errorMessage',500)
        && requiredNumber(request.resource.data,'retentionDays',1,90)
        && (!hasField(request.resource.data,'companyId') || canWriteCompany(request.resource.data.companyId));
      allow read: if canReadOwnedOrCompanyRecord();
      allow update, delete: if false;
    }

    match /importLogs/{importLogId} {
      allow create: if canCreateCompanyRecord();
      allow read: if canReadCompanyRecord();
      allow update, delete: if false;
    }

    match /documents/{documentId} {
      allow create: if validDocumentCreate();
      allow read: if canReadCompanyRecord();
      allow update: if validDocumentUpdate();
      allow delete: if false;
    }

    function validTransactionCore(data) {
      return data.type in ['ingreso', 'gasto']
        && data.amount is number
        && data.amount > 0
        && data.description is string
        && data.description.size() <= 2000
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 100
        && data.paymentMethod in [
          'efectivo',
          'transferencia',
          'tarjeta_credito',
          'tarjeta_debito',
          'cheque'
        ]
        && data.status in ['confirmed', 'pending', 'archived'];
    }

    function validTransactionCreate() {
      let t = request.resource.data;
      return canCreateCompanyRecord()
        && t.keys().hasAll([
          'companyId', 'ownerUid', 'type', 'amount', 'description',
          'date', 'category', 'paymentMethod', 'status'
        ])
        && t.keys().hasOnly([
          'companyId', 'ownerUid', 'type', 'amount',
          'description', 'date', 'category', 'paymentMethod',
          'status', 'reference', 'notes', 'expense_type',
          'isRecurring', 'dueDate', 'supplier_id',
          'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'archivedAt'
        ])
        && validTransactionCore(t);
    }

    function validTransactionUpdate() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();

      return canUpdateCompanyRecord()
        && changedFields.hasOnly([
          'type', 'amount', 'description', 'date',
          'category', 'paymentMethod', 'status',
          'reference', 'notes', 'expense_type',
          'isRecurring', 'dueDate', 'supplier_id',
          'updatedAt', 'updatedBy', 'archivedAt'
        ])
        && (!changedFields.hasAny(['type'])
          || request.resource.data.type in ['ingreso', 'gasto'])
        && (!changedFields.hasAny(['amount'])
          || (request.resource.data.amount is number
            && request.resource.data.amount > 0))
        && (!changedFields.hasAny(['description'])
          || (request.resource.data.description is string
            && request.resource.data.description.size() <= 2000))
        && (!changedFields.hasAny(['date'])
          || (request.resource.data.date is string
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!changedFields.hasAny(['category'])
          || (request.resource.data.category is string
            && request.resource.data.category.size() > 0
            && request.resource.data.category.size() <= 100))
        && (!changedFields.hasAny(['paymentMethod'])
          || request.resource.data.paymentMethod in [
            'efectivo', 'transferencia',
            'tarjeta_credito', 'tarjeta_debito', 'cheque'
          ])
        && (!changedFields.hasAny(['status'])
          || request.resource.data.status in ['confirmed', 'pending', 'archived']);
    }

    match /transactions/{id} {
      allow read: if canReadCompanyRecord();
      allow create: if validTransactionCreate();
      allow update: if validTransactionUpdate();
      allow delete: if false;
    }

    match /crmClients/{id} {
      allow create: if validDomainCreate(validCrmClient(request.resource.data));
      allow read: if canReadCompanyRecord();
      allow update: if validDomainUpdate(validCrmClient(request.resource.data));
      allow delete: if false;
    }

    match /crmDeals/{id} {
      allow create: if validDomainCreate(validCrmDeal(request.resource.data));
      allow read: if canReadCompanyRecord();
      allow update: if validDomainUpdate(validCrmDeal(request.resource.data));
      allow delete: if false;
    }

    match /crmInteractions/{id} {
      allow create: if validDomainCreate(validCrmInteraction(request.resource.data));
      allow read: if canReadCompanyRecord();
      allow update: if validDomainUpdate(validCrmInteraction(request.resource.data));
      allow delete: if false;
    }

    match /employees/{id} {
      allow create: if validSensitiveWorkforceCreate(validEmployee(request.resource.data));
      allow read: if canReadSensitiveWorkforceRecord();
      allow update: if validSensitiveWorkforceUpdate(validEmployee(request.resource.data));
      allow delete: if false;
    }

    match /payroll/{id} {
      allow create: if validSensitiveWorkforceCreate(validPayroll(request.resource.data));
      allow read: if canReadSensitiveWorkforceRecord();
      allow update: if validSensitiveWorkforceUpdate(validPayroll(request.resource.data));
      allow delete: if false;
    }

    match /performanceReviews/{id} {
      allow create: if validSensitiveWorkforceCreate(validReview(request.resource.data));
      allow read: if canReadSensitiveWorkforceRecord();
      allow update: if validSensitiveWorkforceUpdate(validReview(request.resource.data));
      allow delete: if false;
    }

    match /kpis/{id} {
      allow create: if validDomainCreate(validKpi(request.resource.data));
      allow read: if canReadCompanyRecord();
      allow update: if validDomainUpdate(validKpi(request.resource.data));
      allow delete: if false;
    }

    match /projects/{id} {
      allow create: if validDomainCreate(validProject(request.resource.data));
      allow read: if canReadCompanyRecord();
      allow update: if validDomainUpdate(validProject(request.resource.data));
      allow delete: if false;
    }

    match /projectTasks/{id} {
      allow create: if validDomainCreate(validTask(request.resource.data));
      allow read: if canReadCompanyRecord();
      allow update: if validDomainUpdate(validTask(request.resource.data));
      allow delete: if false;
    }

    match /supportTickets/{id} {
      allow create: if validDomainCreate(validTicket(request.resource.data));
      allow read: if canReadCompanyRecord();
      allow update: if validDomainUpdate(validTicket(request.resource.data));
      allow delete: if false;
    }

    match /subscriptions/{id} {
      allow create: if canCreateOwnedOrCompanyRecord();
      allow read: if canReadOwnedOrCompanyRecord();
      allow update: if canUpdateOwnedOrCompanyRecord();
      allow delete: if false;
    }

    match /companyEntitlements/{companyId} {
      allow read: if hasActiveMembership(companyId) || isCompanyOwner(companyId);
      allow create, update, delete: if false;
    }

    match /companyInvitations/{invitationId} {
      allow read, create, update, delete: if false;
    }

    match /companyMetrics/{companyId} {
      allow read: if hasActiveMembership(companyId) || isCompanyOwner(companyId);
      allow create, update, delete: if false;
    }

    match /companyMonthlyMetrics/{metricId} {
      allow read: if hasCompanyId(resource.data) && (hasActiveMembership(resource.data.companyId) || isCompanyOwner(resource.data.companyId));
      allow create, update, delete: if false;
    }

    match /predictionLogs/{id} {
      allow create: if false;
      allow read: if canReadOwnedOrCompanyRecord();
      allow update: if false;
      allow delete: if false;
    }

    match /aiConversations/{id} {
      allow create: if canCreateOwnedOrCompanyRecord();
      allow read: if canReadOwnedOrCompanyRecord();
      allow update: if canUpdateOwnedOrCompanyRecord();
      allow delete: if false;
    }
  }
}
