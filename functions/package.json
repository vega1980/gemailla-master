{
  "name": "gemailla-ai-functions",
  "private": true,
  "version": "1.0.0",
  "description": "Backend seguro de IA para GEMAILLA AI desplegado en Firebase Functions.",
  "main": "index.js",
  "engines": {
    "node": "22",
    "npm": ">=11 <12"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "lint": "node --check index.js && node --check config.js && node --check firebaseAdmin.js && node --check handlers/*.js",
    "test": "npm run lint && node --test tests/*.test.js"
  },
  "dependencies": {
    "@google/genai": "2.15.0",
    "fast-xml-parser": "^5.3.4",
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2",
    "unpdf": "^1.5.1"
  },
  "packageManager": "npm@11.4.2",
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "@google/genai@2.15.0": true,
    "@firebase/util@1.15.2": true
  }
}
